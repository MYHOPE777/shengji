# 复制为 .env 后按实际账号填写。长期密钥只放服务端环境变量。
PORT=3000
DEMO_MODE=true

# 真实阿里云 FileTrans + OSS 配置
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_APP_KEY=
ALIYUN_REGION=cn-shanghai
ALIYUN_FILETRANS_ENDPOINT=https://nls-filetrans.cn-shanghai.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=cn-shanghai
ALIYUN_OSS_PREFIX=transcriber-temp/

# 本机命令路径；加入 PATH 时可以只写 ffmpeg / ffprobe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 任务约束与轮询参数
MAX_FILE_SIZE=2147483648
MAX_DURATION_SECONDS=14400
CHUNK_SECONDS=600
CHUNK_OVERLAP_SECONDS=2
ALIYUN_POLL_INTERVAL_MS=3000
ALIYUN_TIMEOUT_MS=3600000
